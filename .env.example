# =============================================================
# Frontend Environment Variables — Sandeep Singh Portfolio
# =============================================================
# 1. Is file ko copy karo aur naam karo: .env
# 2. VITE_API_BASE_URL mein apna Render backend URL daalo
# =============================================================

# LOCAL DEVELOPMENT (default)
# VITE_API_BASE_URL=http://localhost:8080/api

# PRODUCTION — Render.com backend URL yahan daalo
# Deploy ke baad Render.com dashboard se URL milega
VITE_API_BASE_URL=https://portfolio-backend.onrender.com/api
